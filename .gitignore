# ==========================================
# OrderFlow — Git Ignore Policy
# ==========================================

# Compiled Class files & Packaging
target/
**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# JVM crash logs & Heap dumps
*.log
*.hprof
hs_err_pid*
replay_pid*

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.settings/
.project
.classpath
.factorypath
.metadata/

# Visual Studio Code & Editors
.vscode/
*.code-workspace
.history/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Environment Secrets & Private Keys
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
secrets/

# Temporary & Local Scratch
tmp/
temp/
scratch/
